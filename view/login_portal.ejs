<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in · Assignment Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Warm editorial paper palette */
            --bg: #F5F3EE;
            --paper: #FFFFFF;
            --ink: #1D2130;
            --ink-soft: #565B6B;
            --ink-faint: #9296A3;
            --line: #E4E0D5;

            --student: #3D4CE0;
            --student-tint: #ECEEFC;
            --student-glow: rgba(61, 76, 224, 0.12);

            --admin: #2E6B4E;
            --admin-tint: #E7F3EC;
            --admin-glow: rgba(46, 107, 78, 0.12);

            --radius: 16px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { -webkit-font-smoothing: antialiased; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient floating shapes */
        .ambient-shape {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.6;
        }

        .shape-1 {
            top: -10%;
            left: -5%;
            width: 40vw;
            height: 40vw;
            background: radial-gradient(circle, var(--student-tint), transparent 70%);
        }

        .shape-2 {
            bottom: -10%;
            right: -5%;
            width: 45vw;
            height: 45vw;
            background: radial-gradient(circle, var(--admin-tint), transparent 70%);
        }

        /* Dynamic Grid Background */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: radial-gradient(var(--line) 1.2px, transparent 1.2px);
            background-size: 32px 32px;
            opacity: 0.7;
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4rem 1.5rem 3rem;
        }

        .intro {
            text-align: center;
            max-width: 480px;
            margin-bottom: 3rem;
            animation: fadeInDown 0.7s ease-out;
        }

        .eyebrow {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: var(--ink-faint);
            margin-bottom: 0.9rem;
        }

        .intro h1 {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 2.4rem;
            letter-spacing: -0.025em;
            line-height: 1.15;
            margin-bottom: 0.85rem;
        }

        .intro p {
            color: var(--ink-soft);
            font-size: 1rem;
            line-height: 1.6;
        }

        .cards {
            display: grid;
            gap: 1.5rem;
            width: 100%;
            max-width: 660px;
            grid-template-columns: 1fr;
        }

        @media (min-width: 640px) {
            .cards { grid-template-columns: 1fr 1fr; }
        }

        /* Interactive Elevation Cards */
        .card {
            position: relative;
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 2rem 1.75rem 1.75rem;
            text-decoration: none;
            color: var(--ink);
            display: flex;
            flex-direction: column;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 12px rgba(20, 20, 30, 0.03);
            overflow: hidden;
        }

        /* Folder-tab signature accent */
        .card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 1.75rem;
            width: 2.75rem;
            height: 4px;
            border-radius: 0 0 4px 4px;
            transition: width 0.25s ease;
        }

        .card.student::before { background: var(--student); }
        .card.admin::before { background: var(--admin); }

        .card:hover::before {
            width: 4rem;
        }

        .card:hover {
            transform: translateY(-4px);
        }

        .card.student:hover { 
            border-color: rgba(61, 76, 224, 0.35); 
            box-shadow: 0 16px 32px -12px var(--student-glow);
        }
        
        .card.admin:hover { 
            border-color: rgba(46, 107, 78, 0.35); 
            box-shadow: 0 16px 32px -12px var(--admin-glow);
        }

        /* Header Row inside card */
        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .card-tag {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
        }

        .card.student .card-tag { color: var(--student); background: var(--student-tint); }
        .card.admin .card-tag { color: var(--admin); background: var(--admin-tint); }

        /* Custom Mini SVG Icons */
        .role-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.25s ease;
        }

        .card.student .role-icon { background: var(--student-tint); color: var(--student); }
        .card.admin .role-icon { background: var(--admin-tint); color: var(--admin); }

        .card:hover .role-icon {
            transform: scale(1.1) rotate(-4deg);
        }

        .card-title {
            font-family: 'Fraunces', serif;
            font-size: 1.3rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            margin-bottom: 0.45rem;
        }

        .card-desc {
            font-size: 0.885rem;
            color: var(--ink-soft);
            line-height: 1.55;
            margin-bottom: 1.75rem;
        }

        .card-cta {
            margin-top: auto;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .card.student .card-cta { color: var(--student); }
        .card.admin .card-cta { color: var(--admin); }

        .card-cta svg {
            width: 16px;
            height: 16px;
            transition: transform 0.2s ease;
        }

        .card:hover .card-cta svg { transform: translateX(5px); }

        footer {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 0 1.5rem 2.5rem;
            font-size: 0.85rem;
            color: var(--ink-faint);
        }

        footer a {
            color: var(--ink-soft);
            font-weight: 500;
            text-decoration: none;
            border-bottom: 1px solid var(--line);
            transition: all 0.2s ease;
        }

        footer a:hover { 
            color: var(--ink); 
            border-color: var(--ink-soft); 
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (prefers-reduced-motion: reduce) {
            .card, .card-cta svg, .role-icon { transition: none; animation: none; }
        }

        a:focus-visible, .card:focus-visible {
            outline: 2px solid var(--ink);
            outline-offset: 3px;
        }
    </style>
</head>

<body>

    <div class="ambient-shape shape-1"></div>
    <div class="ambient-shape shape-2"></div>

    <main>
        <div class="intro">
            <div class="eyebrow">Sign in</div>
            <h1>Pick up where you left off</h1>
            <p>Select your assigned portal workspace to view coursework, track deadlines, and manage system reviews.</p>
        </div>

        <div class="cards">
            <a href="/user/login" class="card student">
                <div class="card-header">
                    <span class="card-tag">Student</span>
                    <div class="role-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    </div>
                </div>
                <h2 class="card-title">Student sign in</h2>
                <p class="card-desc">Check upcoming assignment deadlines, turn in coursework, and view professor feedback.</p>
                <span class="card-cta">
                    Enter Portal
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
            </a>

            <a href="/admin/login" class="card admin">
                <div class="card-header">
                    <span class="card-tag">Admin</span>
                    <div class="role-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                    </div>
                </div>
                <h2 class="card-title">Admin sign in</h2>
                <p class="card-desc">Oversee departmental submissions, review pending work, and monitor overall course progress.</p>
                <span class="card-cta">
                    Open Console
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
            </a>
        </div>
    </main>

    <footer>
        Need technical assistance? <a href="#">Contact your help desk</a>
    </footer>

</body>
</html>