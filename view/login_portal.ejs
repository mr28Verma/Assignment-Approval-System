<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in · University Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #F5F3EE;
            --paper: #FFFFFF;
            --ink: #1D2130;
            --ink-soft: #565B6B;
            --ink-faint: #9296A3;
            --line: #E4E0D5;

            --user: #3D4CE0;
            --user-tint: #ECEEFC;

            --admin: #2E6B4E;
            --admin-tint: #E7F3EC;

            --radius: 16px;
            --radius-sm: 8px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
        }

        .ambient-shape {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.6;
            transition: background 0.4s ease;
        }

        .shape-1 {
            top: -10%;
            left: -5%;
            width: 40vw;
            height: 40vw;
            background: radial-gradient(circle, var(--user-tint), transparent 70%);
        }

        .shape-2 {
            bottom: -10%;
            right: -5%;
            width: 45vw;
            height: 45vw;
            background: radial-gradient(circle, #EFECE6, transparent 70%);
        }

        body[data-role="admin"] .shape-1 { background: radial-gradient(circle, var(--admin-tint), transparent 70%); }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: radial-gradient(var(--line) 1.2px, transparent 1.2px);
            background-size: 32px 32px;
            opacity: 0.7;
            pointer-events: none;
            z-index: 0;
        }

        main {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem;
        }

        .intro {
            text-align: center;
            max-width: 480px;
            margin-bottom: 2rem;
            animation: fadeInDown 0.6s ease-out;
        }

        .eyebrow {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--ink-faint);
            margin-bottom: 0.8rem;
        }

        .intro h1 {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 2.25rem;
            letter-spacing: -0.02em;
            line-height: 1.15;
            margin-bottom: 0.5rem;
        }

        .intro p {
            color: var(--ink-soft);
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 2.25rem 2rem;
            box-shadow: 0 12px 32px rgba(20, 20, 30, 0.03);
            position: relative;
        }

        .role-switch {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #EFECE6;
            padding: 4px;
            border-radius: 10px;
            margin-bottom: 1.75rem;
            gap: 2px;
        }

        .role-btn {
            background: transparent;
            border: none;
            color: var(--ink-soft);
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            padding: 0.65rem 0.5rem;
            border-radius: 7px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .role-btn.active.users {
            background: var(--paper);
            color: var(--user);
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .role-btn.active.admin {
            background: var(--paper);
            color: var(--admin);
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .message-box {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #ef4444;
            padding: 0.75rem 1rem;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            text-align: center;
            font-weight: 500;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 0.5rem;
        }

        .forgot-link {
            color: var(--ink-soft);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.8125rem;
        }

        .forgot-link:hover { color: var(--ink); }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 0.875rem;
            color: var(--ink-faint);
            pointer-events: none;
            display: flex;
        }

        .form-input {
            width: 100%;
            height: 46px;
            background: #EFECE6;
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            padding: 0 1rem 0 2.6rem;
            font-family: inherit;
            font-size: 0.875rem;
            color: var(--ink);
            outline: none;
            transition: all 0.2s ease;
        }

        .form-input::placeholder {
            color: var(--ink-faint);
        }

        .form-input:focus {
            background: var(--paper);
            border-color: var(--line);
            box-shadow: 0 0 0 3px rgba(0,0,0,0.04);
        }

        .btn-submit {
            width: 100%;
            height: 46px;
            color: #FFFFFF;
            border: none;
            border-radius: var(--radius-sm);
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s ease;
            margin-top: 0.5rem;
        }

        .btn-submit:hover { opacity: 0.92; }

        body[data-role="users"] .btn-submit { background: var(--user); }
        body[data-role="admin"] .btn-submit { background: var(--admin); }

        footer {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 0 1.5rem 2.5rem;
            font-size: 0.875rem;
            color: var(--ink-faint);
        }

        footer a {
            color: var(--ink-soft);
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-12px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<% 
    const currentRole = (typeof role !== 'undefined' && role) ? role : 'users'; 
    const isAdmin = currentRole === 'admin';
%>

<body data-role="<%= currentRole %>">

    <div class="ambient-shape shape-1"></div>
    <div class="ambient-shape shape-2"></div>

    <main>
        <div class="intro">
            <div class="eyebrow">Sign In</div>
            <h1 id="portal-heading"><%= isAdmin ? 'Admin Portal' : 'User Portal' %></h1>
            <p id="portal-subheading"><%= isAdmin ? 'System Administration & Portal Management' : 'Student, HOD, and Faculty Access' %></p>
        </div>

        <div class="auth-card">
            <div class="role-switch">
                <button type="button" class="role-btn <%= !isAdmin ? 'active users' : '' %>" id="btn-users" onclick="setRole('users')">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    Users
                </button>
                <button type="button" class="role-btn <%= isAdmin ? 'active admin' : '' %>" id="btn-admin" onclick="setRole('admin')">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                    Admin
                </button>
            </div>

            <% if (typeof err !== 'undefined' && err && err.trim().length > 0) { %>
                <div class="message-box"><%= err %></div>
            <% } %>

            <form id="login-form" action="<%= isAdmin ? '/auth/login' : '/user/login' %>" method="POST">
                <input type="hidden" name="role" id="role-input" value="<%= currentRole %>">

                <div class="form-group">
                    <label class="form-label" for="login-identifier" id="label-identifier"><%= isAdmin ? 'Username' : 'University Email' %></label>
                    <div class="input-wrapper">
                        <div class="input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <input type="<%= isAdmin ? 'text' : 'email' %>" 
                               id="login-identifier" 
                               name="<%= isAdmin ? 'username' : 'email' %>" 
                               class="form-input" 
                               placeholder="<%= isAdmin ? 'Enter username' : 'your.name@university.edu' %>" 
                               required 
                               autocomplete="username">
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label">
                        <label for="password">Password</label>
                        <a href="/user/forget" class="forgot-link" id="forgot-link" style="display: <%= isAdmin ? 'none' : 'inline' %>;">Forgot Password?</a>
                    </div>
                    <div class="input-wrapper">
                        <div class="input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </div>
                        <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required autocomplete="current-password">
                    </div>
                </div>

                <button type="submit" class="btn-submit" id="btn-submit"><%= isAdmin ? 'Log In as Admin' : 'Login' %></button>
            </form>
        </div>
    </main>

    <footer>
        Forgot your password? <a href="#" id="support-link">Contact support</a>
    </footer>

    <script>
        function setRole(role, clearInputs = true) {
            const body = document.body;
            const form = document.getElementById('login-form');
            const roleInput = document.getElementById('role-input');
            const btnUsers = document.getElementById('btn-users');
            const btnAdmin = document.getElementById('btn-admin');
            
            const heading = document.getElementById('portal-heading');
            const subheading = document.getElementById('portal-subheading');
            const submitBtn = document.getElementById('btn-submit');
            const identifierInput = document.getElementById('login-identifier');
            const passwordInput = document.getElementById('password');
            const identifierLabel = document.getElementById('label-identifier');
            const forgotLink = document.getElementById('forgot-link');

            if (clearInputs) {
                identifierInput.value = '';
                if (passwordInput) passwordInput.value = '';
            }

            body.setAttribute('data-role', role);
            roleInput.value = role;

            btnUsers.className = 'role-btn';
            btnAdmin.className = 'role-btn';

            if (role === 'admin') {
                btnAdmin.className = 'role-btn active admin';
                heading.textContent = 'Admin Portal';
                subheading.textContent = 'System Administration & Portal Management';
                submitBtn.textContent = 'Log In as Admin';
                
                form.action = '/auth/login';
                identifierLabel.textContent = 'Username';
                identifierInput.name = 'username';
                identifierInput.type = 'text';
                identifierInput.placeholder = 'Enter username';
                forgotLink.style.display = 'none';
            } else {
                btnUsers.className = 'role-btn active users';
                heading.textContent = 'User Portal';
                subheading.textContent = 'Student, HOD, and Faculty Access';
                submitBtn.textContent = 'Login';
                
                form.action = '/user/login';
                identifierLabel.textContent = 'University Email';
                identifierInput.name = 'email';
                identifierInput.type = 'email';
                identifierInput.placeholder = 'your.name@university.edu';
                forgotLink.style.display = 'inline';
            }
        }
    </script>

</body>
</html>