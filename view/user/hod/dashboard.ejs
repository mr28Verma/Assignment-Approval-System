<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HOD Dashboard</title>


    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    >


    <!-- HOD CSS -->

    <link
        rel="stylesheet"
        href="/css/hodcss/dashboard.css"
    >

</head>


<body>


<div class="dashboard-container">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="dashboard-header">


        <div class="header-top">


            <h1>
                HOD Management Dashboard
            </h1>


            <!-- USER PROFILE -->

            <div class="user-profile">


                <div
                    class="user-info"
                    id="userProfileBtn"
                >


                    <div class="user-details">


                        <div class="user-name">

                            <%= name %>

                        </div>


                        <div class="user-role">

                            HEAD OF DEPARTMENT

                        </div>


                    </div>


                    <div class="user-avatar">


                        <img
                            src="<%= profilePic %>"
                            alt="Profile"
                            onerror="this.style.display='none'"
                        >


                    </div>


                </div>


                <!-- PROFILE DROPDOWN -->

                <div
                    class="dropdown-menu"
                    id="dropdownMenu"
                >


                    <!-- SETTINGS -->

                    <a
                        href="/hod/settings"
                        class="dropdown-item"
                    >

                        <i class="fa-solid fa-gear"></i>

                        Settings

                    </a>


                    <!-- LOGOUT -->

                    <a
                        href="/auth/logout"
                        class="dropdown-item logout-item"
                    >

                        <i class="fa-solid fa-power-off"></i>

                        Logout

                    </a>


                </div>


            </div>


        </div>


    </div>



    <!-- ================================================= -->
    <!-- METRICS -->
    <!-- ================================================= -->

    <div class="metrics-grid">


        <!-- PENDING -->

        <div class="metric-card draft">


            <div class="count">

                <%= pending %>

            </div>


            <div class="label">

                Pending Approvals

            </div>


        </div>



        <!-- FACULTY -->

        <div class="metric-card submitted">


            <div class="count">

                <%= faculty %>

            </div>


            <div class="label">

                Total Faculty

            </div>


        </div>



        <!-- APPROVED -->

        <div class="metric-card approved">


            <div class="count">

                <%= approved %>

            </div>


            <div class="label">

                Approved Submissions

            </div>


        </div>



        <!-- REJECTED -->

        <div class="metric-card rejected">


            <div class="count">

                <%= rejected %>

            </div>


            <div class="label">

                Rejected / Returned

            </div>


        </div>


    </div>



    <!-- ================================================= -->
    <!-- SUBMISSIONS -->
    <!-- ================================================= -->

    <div class="recent-section">


        <div class="recent-section-header">


            <h2>

                Department Submissions Overview

            </h2>


            <a
                href="/hod/submissions/all"
                class="view-all-link"
            >

                View All →

            </a>


        </div>



        <!-- ================================================= -->
        <!-- STATUS FILTER -->
        <!-- ================================================= -->

        <form
            action="/hod/status/filter"
            method="POST"
        >


            <div class="filter-controls">


                <label for="statusFilter">

                    Filter by Status:

                </label>


                <select
                    name="status"
                    id="statusFilter"
                >


                    <option value="all">

                        All Status

                    </option>


                    <option value="pending">

                        Pending

                    </option>


                    <option value="forwarded">

                        Forwarded

                    </option>


                    <option value="approved">

                        Approved

                    </option>


                    <option value="rejected">

                        Rejected

                    </option>


                </select>


                <button
                    type="submit"
                    class="apply-btn"
                >

                    Apply

                </button>


            </div>


        </form>



        <!-- ================================================= -->
        <!-- ASSIGNMENT TABLE -->
        <!-- ================================================= -->

        <table
            class="submission-table"
            id="assignmentTable"
        >


            <thead>

                <tr>


                    <th>

                        Assignment Title

                    </th>


                    <th>

                        Student Name

                    </th>


                    <th>

                        Category

                    </th>


                    <th>

                        Status

                    </th>


                    <th>

                        Submission Date

                    </th>


                    <th>

                        Actions

                    </th>


                </tr>

            </thead>



            <tbody>


                <% if (assignments && assignments.length > 0) { %>


                    <% assignments.forEach(a => { %>


                        <tr
                            data-status="<%= a.status %>"
                            data-id="<%= a._id %>"
                        >


                            <!-- TITLE -->

                            <td data-label="Title">

                                <%= a.title %>

                            </td>



                            <!-- STUDENT -->

                            <td data-label="Student">

                                <%= a.student_name %>

                            </td>



                            <!-- CATEGORY -->

                            <td data-label="Category">

                                <%= a.category %>

                            </td>



                            <!-- STATUS -->

                            <td data-label="Status">


                                <span
                                    class="status-badge badge-<%= a.status %>"
                                >

                                    <%= a.status %>

                                </span>


                            </td>



                            <!-- DATE -->

                            <td data-label="Submitted">

                                <%= a.submit %>

                            </td>



                            <!-- ACTIONS -->

                            <td
                                data-label="Actions"
                                class="actions-cell"
                            >


                                <!-- VIEW DOCUMENT -->

                                <a
                                    href="<%= a.upload_path %>"
                                    class="action-btn"
                                    target="_blank"
                                    title="View Document"
                                >

                                    <i class="fa-solid fa-eye"></i>

                                </a>



                                <!-- DOWNLOAD DOCUMENT -->

                                <a
                                    href="<%= a.download %>"
                                    class="action-btn"
                                    title="Download Document"
                                >

                                    <i class="fa-solid fa-download"></i>

                                </a>



                                <!-- ================================================= -->
                                <!-- HOD FINAL DECISION -->
                                <!-- ONLY FORWARDED ASSIGNMENTS -->
                                <!-- ================================================= -->

                                <% if (a.status === 'forwarded') { %>


                                    <div class="decision-group">


                                        <!-- ACCEPT -->

                                        <button
                                            type="button"
                                            class="decision-btn approve-btn review-modal-btn"
                                            data-id="<%= a._id %>"
                                            data-title="<%= a.title %>"
                                            data-action="approve"
                                            title="Accept Submission"
                                        >

                                            <i class="fa-solid fa-check"></i>

                                            Accept

                                        </button>



                                        <!-- REJECT -->

                                        <button
                                            type="button"
                                            class="decision-btn reject-btn review-modal-btn"
                                            data-id="<%= a._id %>"
                                            data-title="<%= a.title %>"
                                            data-action="reject"
                                            title="Reject Submission"
                                        >

                                            <i class="fa-solid fa-xmark"></i>

                                            Reject

                                        </button>


                                    </div>


                                <% } %>


                            </td>


                        </tr>


                    <% }); %>


                <% } else { %>


                    <!-- NO ASSIGNMENTS -->

                    <tr class="no-assignments">


                        <td
                            colspan="6"
                        >

                            No submissions found.

                        </td>


                    </tr>


                <% } %>


            </tbody>


        </table>


    </div>


</div>



<!-- ===================================================== -->
<!-- REVIEW MODAL -->
<!-- ===================================================== -->

<div
    id="reviewModal"
    class="modal"
>


    <div class="modal-content">


        <!-- CLOSE -->

        <button
            type="button"
            class="close-button"
            id="closeModal"
        >

            &times;

        </button>



        <!-- TITLE -->

        <h2 id="modalTitle">

            Review Submission

        </h2>



        <!-- ASSIGNMENT -->

        <p class="reviewing-text">

            Reviewing:

            <span id="assignmentTitleDisplay"></span>

        </p>



        <!-- REVIEW FORM -->

        <form
            id="reviewForm"
            method="POST"
        >


            <!-- ASSIGNMENT ID -->

            <input
                type="hidden"
                id="assignmentId"
                name="assignmentId"
            >



            <!-- ACTION -->

            <input
                type="hidden"
                id="reviewAction"
                name="action"
            >



            <!-- REMARKS -->

            <div class="form-group">


                <label for="reviewRemarks">

                    Remarks / Feedback:

                </label>


                <textarea
                    id="reviewRemarks"
                    name="remarks"
                    rows="5"
                    placeholder="Enter review comments or reasons for rejection..."
                ></textarea>


            </div>



            <!-- CONFIRM -->

            <button
                type="submit"
                class="confirm-submit-btn"
                id="confirmBtn"
            >

                Submit Decision

            </button>


        </form>


    </div>


</div>



<!-- ===================================================== -->
<!-- JAVASCRIPT -->
<!-- ===================================================== -->

<script>


document.addEventListener(
    'DOMContentLoaded',
    () => {


        // =================================================
        // ELEMENTS
        // =================================================

        const modal =
            document.getElementById(
                'reviewModal'
            );


        const modalContent =
            document.querySelector(
                '.modal-content'
            );


        const closeButton =
            document.getElementById(
                'closeModal'
            );


        const modalTitle =
            document.getElementById(
                'modalTitle'
            );


        const assignmentTitleDisplay =
            document.getElementById(
                'assignmentTitleDisplay'
            );


        const assignmentIdInput =
            document.getElementById(
                'assignmentId'
            );


        const reviewActionInput =
            document.getElementById(
                'reviewAction'
            );


        const confirmBtn =
            document.getElementById(
                'confirmBtn'
            );


        const reviewForm =
            document.getElementById(
                'reviewForm'
            );


        const reviewBtns =
            document.querySelectorAll(
                '.review-modal-btn'
            );



        // =================================================
        // OPEN REVIEW MODAL
        // =================================================

        reviewBtns.forEach(
            btn => {


                btn.addEventListener(
                    'click',
                    () => {


                        const title =
                            btn.dataset.title;


                        const assignmentId =
                            btn.dataset.id;


                        const action =
                            btn.dataset.action;



                        // Assignment title

                        assignmentTitleDisplay
                            .textContent =
                            title;



                        // Assignment ID

                        assignmentIdInput
                            .value =
                            assignmentId;



                        // Action

                        reviewActionInput
                            .value =
                            action;



                        // =================================================
                        // BACKEND URL
                        // =================================================

                        reviewForm.action =
                            `/hod/assignment/review/${assignmentId}`;



                        // =================================================
                        // APPROVE MODAL
                        // =================================================

                        if (
                            action === 'approve'
                        ) {


                            modalTitle
                                .textContent =
                                'Accept Submission';


                            confirmBtn
                                .textContent =
                                'Confirm Acceptance';


                            confirmBtn
                                .classList
                                .remove(
                                    'reject-confirm'
                                );


                            confirmBtn
                                .classList
                                .add(
                                    'approve-confirm'
                                );


                            confirmBtn
                                .style
                                .backgroundColor =
                                '#28a745';


                            modalContent
                                .style
                                .borderLeftColor =
                                '#28a745';


                        }


                        // =================================================
                        // REJECT MODAL
                        // =================================================

                        else {


                            modalTitle
                                .textContent =
                                'Reject Submission';


                            confirmBtn
                                .textContent =
                                'Confirm Rejection';


                            confirmBtn
                                .classList
                                .remove(
                                    'approve-confirm'
                                );


                            confirmBtn
                                .classList
                                .add(
                                    'reject-confirm'
                                );


                            confirmBtn
                                .style
                                .backgroundColor =
                                '#dc3545';


                            modalContent
                                .style
                                .borderLeftColor =
                                '#dc3545';


                        }



                        // Show modal

                        modal.style.display =
                            'flex';


                    }
                );

            }
        );



        // =================================================
        // CLOSE MODAL
        // =================================================

        closeButton.addEventListener(
            'click',
            () => {

                modal.style.display =
                    'none';

            }
        );



        // =================================================
        // CLICK OUTSIDE MODAL
        // =================================================

        modal.addEventListener(
            'click',
            event => {


                if (
                    event.target === modal
                ) {

                    modal.style.display =
                        'none';

                }

            }
        );



        // =================================================
        // USER DROPDOWN
        // =================================================

        const userProfileBtn =
            document.getElementById(
                'userProfileBtn'
            );


        const dropdownMenu =
            document.getElementById(
                'dropdownMenu'
            );


        if (
            userProfileBtn &&
            dropdownMenu
        ) {


            userProfileBtn.addEventListener(
                'click',
                event => {


                    event.stopPropagation();


                    dropdownMenu.classList.toggle(
                        'show'
                    );


                }
            );



            document.addEventListener(
                'click',
                event => {


                    if (
                        !userProfileBtn.contains(
                            event.target
                        )
                    ) {


                        dropdownMenu
                            .classList
                            .remove(
                                'show'
                            );


                    }

                }
            );

        }


    }
);


</script>


</body>

</html>